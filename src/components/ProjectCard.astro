---
import { Icon } from "astro-icon/components";

const { project } = Astro.props;

const backgroundStyle = project.image
	? {
			backgroundImage: `url(${project.image})`,
			backgroundSize: "contain",
			backgroundRepeat: "no-repeat",
			backgroundPosition: "center",
			backgroundColor: "var(--card-bg, oklch(0.23 0.015 var(--hue, 250)))",
		}
	: {};
---

<a
	href={project.href}
	target="_blank"
	rel="noopener noreferrer"
	class="project-card group block relative w-full h-[230px] mt-3 mb-6 cursor-pointer overflow-hidden rounded-xl border border-white/20 dark:border-white/10 shadow-lg shadow-black/5 dark:shadow-black/20"
	style={backgroundStyle}
	aria-label={`Ver projeto ${project.title}`}
>
	<!-- Fallback gradient quando não há imagem (sutil, em harmonia com o tema) -->
	{!project.image && (
		<div
			class="absolute inset-0 -z-10"
			style="background: linear-gradient(135deg, oklch(0.55 0.12 var(--hue, 250)) 0%, oklch(0.40 0.14 calc(var(--hue, 250) + 60)) 100%);"
		/>
	)}

	<!-- Overlay glass sutil no card inteiro para contraste com o container -->
	<div class="project-card-glass-overlay absolute inset-0 rounded-xl pointer-events-none" aria-hidden="true" />

	<!-- Título: centralizado a 50% da altura do card -->
	<h2 class="project-card__title">
		{project.title}
	</h2>

	<div class="project-card__container absolute inset-0 overflow-hidden">
		<!-- Descrição completa: mais à esquerda, quebra de linha, começa abaixo do título -->
		<div class="project-card__text-block absolute inset-0 opacity-0 translate-x-full group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-400 ease-in-out flex flex-col pt-[9rem] pr-6 pb-4 pl-6 text-sm text-white rounded-xl overflow-hidden">
			<p class="project-card__description m-0 leading-relaxed flex-1 min-h-0">{project.description}</p>
		</div>
	</div>

	<span class="absolute bottom-3 right-3 z-10 text-white/90 text-xs opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center gap-1 backdrop-blur-sm bg-black/30 dark:bg-white/10 px-2 py-1 rounded">
		Ver projeto
		<Icon name="fa6-solid:arrow-up-right-from-square" class="text-sm" />
	</span>
</a>

<style>
	/* Título a 50% da altura do card, centralizado verticalmente */
	.project-card__title {
		position: absolute;
		top: 50%;
		left: 1.5rem;
		transform: translateY(-50%);
		margin: 0;
		font-size: 1.25em;
		padding: 0.25rem 0.75rem;
		z-index: 1;
		transition: transform 0.2s ease-in-out;
		font-weight: 600;
		border-radius: 0.5rem;
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		background: rgba(255, 255, 255, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.3);
		color: oklch(0.2 0 0);
		max-width: calc(100% - 3rem);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	:root.dark .project-card__title {
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.15);
		color: white;
	}

	.project-card.group:hover .project-card__title {
		transform: translate(-1.5rem, -50%);
	}

	/* Overlay só com cor (sem backdrop-filter) para não desfocar a imagem de fundo */
	.project-card-glass-overlay {
		background: rgba(255, 255, 255, 0.06);
	}

	:root.dark .project-card-glass-overlay {
		background: rgba(0, 0, 0, 0.12);
	}

	/* Painel de descrição no hover: glass escuro com blur */
	.project-card__text-block {
		background: linear-gradient(
			-75deg,
			rgba(0, 0, 0, 0.75) 50%,
			rgba(30, 30, 30, 0.6) 70%,
			rgba(0, 0, 0, 0) 20%
		);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-left: 1px solid rgba(255, 255, 255, 0.08);
	}

	:root.dark .project-card__text-block {
		background: linear-gradient(
			-75deg,
			rgba(0, 0, 0, 0.85) 50%,
			rgba(20, 20, 20, 0.7) 70%,
			rgba(0, 0, 0, 0) 20%
		);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-left: 1px solid rgba(255, 255, 255, 0.06);
	}

	/* Descrição completa: quebra de linha, não sobrepõe o título, scroll se for longa */
	.project-card__description {
		word-break: break-word;
		white-space: normal;
		
	}
</style>
